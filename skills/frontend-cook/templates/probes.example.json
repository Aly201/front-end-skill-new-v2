[
  {
    "name": "contact form submits and shows the thank-you text",
    "page": "/",
    "viewport": "desktop",
    "mock": [
      { "url": "/api/contact", "status": 200, "body": { "ok": true } }
    ],
    "steps": [
      { "fill": { "label": "Name", "value": "Test User" } },
      { "fill": { "label": "Email", "value": "test@example.com" } },
      { "fill": { "label": "Message", "value": "Hello from the probe" } },
      { "click": { "role": "button", "name": "Send" } }
    ],
    "expect": [
      { "request": "/api/contact" },
      { "text": "Thanks" }
    ]
  },
  {
    "name": "mobile menu opens and shows the navigation",
    "page": "/",
    "viewport": "mobile",
    "steps": [
      { "click": { "role": "button", "name": "Menu" } }
    ],
    "expect": [
      { "visible": { "role": "navigation" } }
    ]
  }
]
